<?xml version="1.0" encoding="utf-8"?>
<!--
    The 1x1 widget. The glyph is the whole control and carries the state too: pause bars while audio
    runs, the play triangle when it does not.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="7dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/home_action_play"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_play"
        android:tint="@color/widget_on_accent" />

    <TextView
        android:id="@+id/widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:text="@string/widget_state_stopped"
        android:textColor="@color/widget_on_surface"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
