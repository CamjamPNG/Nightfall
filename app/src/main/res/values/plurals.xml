<?xml version="1.0" encoding="utf-8"?>
<!--
    Counts that genuinely vary, so a translator can give each language the forms it needs. English
    has two, and the rendered text is the same as before this file existed: the code already chose
    between a singular and a plural word.
-->
<resources>

    <plurals name="unit_layers">
        <item quantity="one">%1$d layer</item>
        <item quantity="other">%1$d layers</item>
    </plurals>

    <plurals name="unit_seconds">
        <item quantity="one">%1$d second</item>
        <item quantity="other">%1$d seconds</item>
    </plurals>

    <!--
        Both counts reach one on a real device: the library count is what a search or a category
        filter leaves, and the saved count is how many mixes the person has made. English reads the
        same at every quantity, so this exists for languages that inflect the noun.
    -->
    <plurals name="library_available">
        <item quantity="one">%1$d available</item>
        <item quantity="other">%1$d available</item>
    </plurals>

    <plurals name="presets_saved">
        <item quantity="one">%1$d saved</item>
        <item quantity="other">%1$d saved</item>
    </plurals>

    <plurals name="home_layer_count">
        <item quantity="one">%1$d layer · hold the grip to reorder</item>
        <item quantity="other">%1$d layers · hold the grip to reorder</item>
    </plurals>

    <plurals name="home_capacity_warning">
        <item quantity="one">This mix is approaching the device’s audio capacity. Reduce music effects or layers if you hear gaps. Render load %1$d%% · %2$d underrun</item>
        <item quantity="other">This mix is approaching the device’s audio capacity. Reduce music effects or layers if you hear gaps. Render load %1$d%% · %2$d underruns</item>
    </plurals>

    <!-- The layer count on the lock screen, with the timer suffix passed in as %2$s. -->
    <plurals name="notification_artist">
        <item quantity="one">%1$d layer%2$s</item>
        <item quantity="other">%1$d layers%2$s</item>
    </plurals>

    <!-- Spoken, not drawn: the timer was just set to this many minutes. -->
    <plurals name="a11y_timer_set">
        <item quantity="one">Sleep timer set, %1$d minute</item>
        <item quantity="other">Sleep timer set, %1$d minutes</item>
    </plurals>

    <!-- Spoken, not drawn: this is how much of a typed phrase became a mix. -->
    <plurals name="describe_a11y_understood">
        <item quantity="one">Understood: %1$d sound ready to play</item>
        <item quantity="other">Understood: %1$d sounds ready to play</item>
    </plurals>
</resources>
